#include <stdio.h>

double findMedian(int arr1[], int arr2[], int n) {
    int i = 0, j = 0, count;
    int m1 = -1, m2 = -1;
    for (count = 0; count <= n; count++) {
        if (i == n) {
            m1 = m2;
            m2 = arr2[0];
            break;
        } else if (j == n) {
            m1 = m2;
            m2 = arr1[0];
            break;
        }

        if (arr1[i] <= arr2[j]) {
            m1 = m2;
            m2 = arr1[i];
            i++;
        } else {
            m1 = m2;
            m2 = arr2[j];
            j++;
        }
    }

    return (m1 + m2) / 2.0;
}

int main() {
    int arr1[] = {1, 3, 5};
    int arr2[] = {2, 4, 6};
    int n = sizeof(arr1)/sizeof(arr1[0]);
    printf("Median of the two sorted arrays is: %.2f\n", findMedian(arr1, arr2, n));
    return 0;
}
